{
  "name": "harborlog",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first marina maintenance log for vessels, service tasks, parts checklists, and activity.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --port 5173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "preview": "vite preview --port 5173 --strictPort"
  },
  "dependencies": {
    "@builder.io/qwik": "^1.20.1",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/static": "^1.4.10",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
